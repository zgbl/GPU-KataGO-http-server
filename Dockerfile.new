# Minimal base - plain Ubuntu, let AppImage's bundled CUDA handle everything
# The NVIDIA Container Runtime injects the driver stub (libcuda.so.1) at runtime
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV PATH="/app/bin:$PATH"

WORKDIR /app

# Runtime dependencies only - no CUDA base image needed
# KataGo AppImage bundles its own CUDA 12.5 runtime libraries
RUN apt-get update && apt-get install -y \
    libzip4 \
    zlib1g \
    python3 \
    python3-pip \
    python3-dev \
    libgoogle-perftools4 \
    curl \
    libstdc++6 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/logs /app/models /app/configs /app/bin /app/katago-server

# Extract KataGo AppImage (bundles CUDA 12.5 runtime, cuDNN 8.9.7, and all deps)
COPY katago-v1.16.4-cuda12.5-cudnn8.9.7-linux-x64+bs50/katago /app/bin/katago_appimage
RUN chmod +x /app/bin/katago_appimage && \
    cd /app/bin && \
    ./katago_appimage --appimage-extract && \
    mv squashfs-root /app/katago_extracted && \
    ln -s /app/katago_extracted/usr/bin/katago /app/bin/katago

# Set library path so AppImage's bundled CUDA libs are found
# The NVIDIA Container Runtime will inject libcuda.so.1 at container start
ENV LD_LIBRARY_PATH="/app/katago_extracted/usr/lib:/app/katago_extracted/usr/lib/x86_64-linux-gnu"

# Copy configs and weight
COPY katago-v1.16.4-cuda12.5-cudnn8.9.7-linux-x64+bs50/*.cfg /app/configs/
COPY Weights/kata1-b18c384nbt-s9996604416-d4316597426.bin.gz /app/models/model.bin.gz

# Copy HTTP server code
COPY katago-server/katago_gtp_bot.py /app/katago-server/
COPY katago-server/get_bot_app.py /app/katago-server/
COPY katago-server/katago_server.py /app/katago-server/
COPY katago-server/requirements.txt /app/
COPY katago_analysis_server.py /app/

RUN pip3 install --no-cache-dir -r /app/requirements.txt && \
    pip3 install --no-cache-dir flask-cors

RUN echo '{"katago_binary": "/app/bin/katago", "model_file": "/app/models/model.bin.gz", "config_file": "/app/configs/custom_katago.cfg", "port": 8080, "max_variations": 15}' > /app/server_config.json

COPY configs/katago_gtp.cfg /app/configs/custom_katago.cfg

EXPOSE 8080

CMD ["python3", "/app/katago_analysis_server.py"]
